[Unit]
Description=KIKI desktop pet (voice-first sprite, no chat stage)
PartOf=graphical-session.target
After=graphical-session.target kiki-orchestrator.service
Wants=kiki-orchestrator.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/kiki/voice.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m kiki.ui.pet_service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
